
<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h2 class="mb-4">
        <i class="fa-solid fa-heart" style="color: #fe424d;"></i>
        My Wishlist
    </h2>

    <% if (wishlistListings.length === 0) { %>

        <div class="text-center mt-5">

            <i
                class="fa-regular fa-heart"
                style="font-size: 3rem; color: #fe424d;"
            ></i>

            <h3 class="mt-3">Your wishlist is empty</h3>

            <p class="text-muted">
                Save stays you love and they'll appear here.
            </p>

            <a href="/listings" class="btn btn-danger">
                Explore stays
            </a>

        </div>

    <% } else { %>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1">

            <% for (let listing of wishlistListings) { %>

                <div class="col mb-4">

                    <a
                        href="/listings/<%= listing._id %>"
                        class="listing-link"
                    >

                        <div class="card listing-card">

                            <img
                                src="<%= listing.image.url %>"
                                class="card-img-top"
                                alt="<%= listing.title %>"
                            />

                            <div class="card-img-overlay">

                                <p class="card-text">

                                    <b><%= listing.title %></b>

                                    <br>

                                    &#8377;
                                    <%= listing.price.toLocaleString("en-IN") %>
                                    / night

                                </p>

                            </div>

                        </div>

                    </a>

                </div>

            <% } %>

        </div>

    <% } %>

</div>