<% layout("/layouts/boilerplate") %>

<style>
#filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    margin-top: 1rem;
}

.filter {
    text-align: center;
    opacity: 0.7;
    transition: 0.2s ease;
}

.filter:hover {
    opacity: 1;
    cursor: pointer;
}

.filter p {
    font-size: 0.8rem;
    margin-top: 0.3rem;
    margin-bottom: 0;
}

.filter i {
    font-size: 1.2rem;
}

.tax-info {
    display: none;
}

.tax-switch{
border: 1px solid black;
border-radius: 1rem;
height: 3.25rem;
padding: 1rem;
margin-left: auto;
display: flex;
align-items: center;
}

.no-results {
    width: 100%;
    min-height: 350px;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;
}

.no-results i {
    font-size: 3rem;
    color: #fe424d;
    margin-bottom: 1rem;
}

.no-results h3 {
    font-size: 1.7rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.no-results p {
    color: #6c757d;
    margin-bottom: 1.5rem;
}

.explore-btn {
    background-color: #fe424d;
    color: white;
    border-radius: 25px;
    padding: 0.6rem 1.5rem;
}

.explore-btn:hover {
    background-color: #e63946;
    color: white;
}
.wishlist-form {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 10;
}

.wishlist-btn {
    background: white;
    border: none;
    border-radius: 50%;
    width: 38px;
    height: 38px;

    display: flex;
    justify-content: center;
    align-items: center;

    cursor: pointer;
    font-size: 1.2rem;

    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.wishlist-btn:hover {
    transform: scale(1.08);
}

.wishlist-btn i {
    color: #fe424d;
}
.listing-card {
    position: relative;
}
  
</style>

<div id="filters">

<a href="/listings?filter=trending" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-fire"></i>
        </div>
        <p>Trending</p>
    </div>
</a>

       <a href="/listings?category=Heritage" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-landmark"></i>
        </div>
        <p>Heritage</p>
    </div>
</a>
     <a href="/listings?category=City" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-mountain-city"></i>
        </div>
        <p>City</p>
    </div>
</a>

    <a href="/listings?category=Mountain" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-mountain"></i>
        </div>
        <p>Mountain</p>
    </div>
</a>
    <a href="/listings?category=Beach" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-umbrella-beach"></i>
        </div>
        <p>Beaches</p>
    </div>
</a>
 <a href="/listings?category=Nature" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-cannabis"></i>
        </div>
        <p>Nature</p>
    </div>
</a>
 <a href="/listings?category=Unique" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-clover"></i>
        </div>
        <p>Unique</p>
    </div>
</a>
    
<!-- LUXURY -->
<a href="/listings?filter=luxury" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-gem"></i>
        </div>
        <p>Luxury</p>
    </div>
</a>

<!-- BUDGET -->
<a href="/listings?filter=budget" class="filter-link">
    <div class="filter">
        <div>
            <i class="fa-solid fa-wallet"></i>
        </div>
        <p>Budget</p>
    </div>
</a>
<a href="/listings?filter=premium" class="filter-link">
    <div class="filter">
        <div><i class="fa-solid fa-star"></i></div>
        <p>Premium</p>
    </div>
</a>
<a href="/listings?filter=weekend" class="filter-link">
    <div class="filter">
        <div><i class="fa-solid fa-suitcase-rolling"></i></div>
        <p>Weekend</p>
    </div>
</a>

    <div class="tax-switch">
        <div class="form-check reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">
    Show taxes
</label>
</div>
    </div>
</div>

<% if (allListing.length === 0) { %>

    <div class="no-results">

        <i class="fa-solid fa-magnifying-glass"></i>

        <h3>No stays found</h3>

        <p>
            We couldn't find any stays matching your search.
        </p>

        <a href="/listings" class="btn explore-btn">
            Explore all stays
        </a>

    </div>

<% } else { %>

    <div class="listings-grid mt-4">

        <% for(let listing of allListing) { %>

            <div class="card listing-card">

                <!-- Listing link -->
                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link"
                >

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                    />

                    <div class="card-img-overlay">

                        <p class="card-text">

                            <b><%= listing.title %></b>

                            <br>

                            &#8377;
                            <%= listing.price.toLocaleString("en-IN") %>
                            / night

                            <i class="tax-info">
                                &nbsp;&nbsp; +18% GST
                            </i>

                        </p>

                    </div>

                </a>


                <!-- Wishlist heart -->
                <form
                    action="/wishlist/<%= listing._id %>"
                    method="POST"
                    class="wishlist-form"
                >

                    <%
                        const isWishlisted =
                            currUser &&
                            wishlist &&
                            wishlist.some(
                                id => id.toString() === listing._id.toString()
                            );
                    %>

                    <button
                        type="submit"
                        class="wishlist-btn"
                    >

                        <% if (isWishlisted) { %>

                            <i class="fa-solid fa-heart heart-active"></i>

                        <% } else { %>

                            <i class="fa-regular fa-heart"></i>

                        <% } %>

                    </button>

                </form>

            </div>

        <% } %>

    </div>

<% } %>

   <script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    const taxInfo = document.getElementsByClassName("tax-info");

    taxSwitch.addEventListener("change", () => {
        for (let info of taxInfo) {
            if (taxSwitch.checked) {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
</script>



